# Copy to .env.local for development, and set these in Vercel Project Settings
# for production. Without RESEND_API_KEY the contact/careers/resume forms
# will show a graceful "please call/email us" message instead of silently
# failing.

# Get a free API key at https://resend.com
RESEND_API_KEY=

# Where form submissions should be delivered. Defaults to the business email
# in content/site-content.ts if not set.
CONTACT_TO_EMAIL=witherspoonhomecare@gmail.com

# The production URL of this site, used in metadata, sitemap.xml, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.witherspoonhomecare.com

# TinaCMS (see README.md "Content editing (TinaCMS)" for full setup steps).
# Both come from app.tina.io, under your project's Overview and Tokens tabs.
# Without these, `npm run dev` still works using Tina's local editing mode,
# but the hosted /admin editor won't connect to Tina Cloud.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
