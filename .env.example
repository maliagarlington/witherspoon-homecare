# Copy to .env.local for development, and set these in Vercel Project Settings
# for production. Without RESEND_API_KEY the contact/careers forms will show a
# graceful "please call/email us" message instead of silently failing.

# Get a free API key at https://resend.com
RESEND_API_KEY=

# Where form submissions should be delivered. Defaults to the business email
# in content/site-content.ts if not set.
CONTACT_TO_EMAIL=witherspoonhomecare@gmail.com

# The production URL of this site — used in metadata, sitemap.xml, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.witherspoonhomecare.com
